# Yerelde .env.local dosyasına, Vercel'de Project Settings > Environment Variables bölümüne ekleyin.
# Gizli anahtarı kaynak koda, .env.example dosyasına veya sohbete koymayın.
RESEND_API_KEY=
# Resend'de alan adı doğrulandıktan sonra kullanacağınız gönderici adresi.
RESEND_FROM_EMAIL=
# İletişim formu mesajlarının ulaşacağı gelen kutusu.
CONTACT_EMAIL=
# Domain Vercel'e bağlandıktan sonra HTTPS kök adresini girin (örn. https://www.ornek.com).
# NEXT_PUBLIC_SITE_URL=
# Open Graph, canonical, sitemap ve robots metadata'sında kullanılır.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_URL=
